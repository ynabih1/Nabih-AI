# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_CLIENT_ID: Required for Google Sign-In on Android.
# Obtain this from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs -> Web application
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

# MICROSOFT_CLIENT_ID: Required for Microsoft Account Sign-In on Android.
# Obtain this from Microsoft Azure Portal -> App Registrations
MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID

