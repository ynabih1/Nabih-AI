# =====================================================================================
# [English] WARNING: THIS FILE IS FOR ILLUSTRATION PURPOSES ONLY.
# Do NOT place your real API keys in this file. It is tracked by Git.
#
# To build and run this project manually outside of AI Studio (e.g. in Android Studio):
# 1. Copy this file and rename it to '.env' in the project root directory.
# 2. Open '.env' and replace 'MY_GEMINI_API_KEY' with your real Gemini API key.
#
# [العربية] تحذير: هذا الملف للتوضيح فقط ولا ينبغي وضع مفاتيح حقيقية فيه لأنه يتتبع بواسطة Git.
#
# لبناء وتشغيل هذا المشروع يدوياً خارج بيئة AI Studio (على سبيل المثال في Android Studio):
# 1. قم بنسخ هذا الملف وتسميته بـ '.env' في المجلد الرئيسي للمشروع.
# 2. افتح ملف '.env' واستبدل 'MY_GEMINI_API_KEY' بمفتاح Gemini API الحقيقي الخاص بك.
# =====================================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

